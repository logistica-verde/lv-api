# Copie para .env e preencha. O .env nao vai para o git.

# Senha do usuario sa do SQL Server (minimo 8 caracteres, com maiuscula, minuscula, numero e simbolo)
DB_PASSWORD=

# Segredo dos tokens JWT, com pelo menos 32 caracteres (gere com: openssl rand -base64 48)
JWT_SECRET=

# Chave privada da conta que assina as ancoragens no Besu.
# A rede do compose cobra gas zero, entao esta conta nao precisa de saldo. A chave e uma conta de
# testes publica: so serve porque a porta do Besu nao e publicada. Nunca use em uma rede com valor real.
BESU_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
BESU_CHAIN_ID=1337

# Endereco do contrato AuditRegistry. Fica vazio no primeiro start; veja o README para implantar.
BESU_CONTRACT_ADDRESS=

# Primeiro administrador (criado so se a tabela de usuarios estiver vazia)
LV_ADMIN_EMAIL=
LV_ADMIN_PASSWORD=
LV_ADMIN_NAME=Administrador

# Endereco publico do sistema, usado na lista de origens permitidas (CORS)
PUBLIC_URL=http://localhost
WEB_PORT=80

# Dominio para HTTPS (so com --profile https; use WEB_PORT=8081 nesse caso)
DOMAIN=

# osrm usa o OSRM e a elevacao; database usa a tabela malha_viaria
GEO_PROVIDER=osrm

# Contato real do projeto, exigido pelo Nominatim
LV_GEOCODER_USER_AGENT=lv-api/1.0 (Logistica Verde Inteligente; contato@exemplo.com)

# Sem o lv-optimizer no compose por enquanto. Aponte para onde ele estiver quando existir.
OPTIMIZER_URL=http://optimizer:8000
